# Frontend Local Development Environment (.env.example)
# In development, leave VITE_API_URL empty to use the Vite proxy defined in vite.config.js,
# or set it to http://localhost:8080 if hitting the backend directly.
VITE_API_URL=
VITE_API_BASE_URL=

# Proxy targets for local development (defaults to localhost:8080, 8081, 8082)
VITE_INVENTORY_SERVICE_URL=http://localhost:8080
VITE_PAYMENT_SERVICE_URL=http://localhost:8081
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8082
