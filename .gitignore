# =====================================================================
# Smart Inventory & Billing Management System — Root .gitignore
# =====================================================================

# Dependencies
node_modules/
**/node_modules/

# Maven & Java build outputs
target/
**/target/
**/*.jar
**/*.war

# Frontend production builds
dist/
**/dist/
frontend/dist/
frontend/.vite/

# Environment files & secrets (never commit real credentials)
.env
.env.*
**/.env
**/.env.*

# Explicitly track example environment templates
!.env.example
!**/.env.example
!.env.production.example
!**/.env.production.example

# Logs
logs/
**/logs/
**/*.log

# IDE & Editor settings
.idea/
*.iml
.vscode/
*.suo

# Operating System
.DS_Store
Thumbs.db
