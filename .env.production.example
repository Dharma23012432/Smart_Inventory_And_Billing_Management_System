# =====================================================================
# Smart Inventory & Billing Management System - Production Environment (.env.production.example)
# Use this template for deploying to Production (AWS / DigitalOcean / GCP / VPS).
# Ensure strong randomly generated passwords are set before starting containers.
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------
POSTGRES_DB=smart_inventory_prod
POSTGRES_USER=inventory_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_STRONG_PASSWORD_32_CHARS_MIN
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# Message Broker (RabbitMQ)
# ---------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=rabbit_admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_TO_A_STRONG_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---------------------------------------------------------------------
# Backend Microservices Ports & Internal Configuration
# ---------------------------------------------------------------------
INVENTORY_SERVICE_PORT=8080
PAYMENT_SERVICE_PORT=8081
NOTIFICATION_SERVICE_PORT=8082

# ---------------------------------------------------------------------
# Frontend Client Configuration
# In production, set VITE_API_URL to your public domain or leave empty if using reverse proxy / nginx routing.
# ---------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_URL=https://inventory.yourdomain.com
APP_CORS_ALLOWED_ORIGINS=https://inventory.yourdomain.com,https://app.yourdomain.com

# ---------------------------------------------------------------------
# Email Notifications (Production SMTP)
# ---------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notifications@yourdomain.com
SPRING_MAIL_PASSWORD=SECURE_SMTP_CREDENTIALS_HERE
APP_MAIL_FROM=notifications@yourdomain.com
